[Unit]
Description=Passerelle Mistral Workflows pour le VPS Allovente
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/allovente-gateway
EnvironmentFile=/home/ubuntu/allovente-gateway/.env
ExecStart=/home/ubuntu/allovente-gateway/.venv/bin/python worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
